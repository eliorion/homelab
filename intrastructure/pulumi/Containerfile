FROM docker.io/pulumi/pulumi:3.204.0-nonroot

# Ensure python3 and pip available
RUN apk add --no-cache python3 py3-pip bash git openssh-client ca-certificates curl util-linux mkisofs || \
    (apt-get update && apt-get install -y python3 python3-pip git openssh-client ca-certificates curl genisoimage)

WORKDIR /app
COPY requirements.txt /app/requirements.txt
RUN pip3 install --no-cache-dir -r /app/requirements.txt

# entrypoint default to bash for interactive runs
ENTRYPOINT ["/bin/bash"]